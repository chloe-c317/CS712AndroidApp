<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SecondActivity">

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:text="@string/second_activity_title"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="25sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.488"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.149" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8sp">

        <TextView
            android:id="@+id/firstChallenge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Device Fragmentation"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.498"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView"
            app:layout_constraintVertical_bias="0.076" />

        <TextView
            android:id="@+id/secondChallenge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OS Fragmentation"
            tools:layout_editor_absoluteX="168dp"
            tools:layout_editor_absoluteY="252dp" />

        <TextView
            android:id="@+id/thirdChallenge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unstable, Dynamic Environments"
            tools:layout_editor_absoluteX="168dp"
            tools:layout_editor_absoluteY="309dp" />

        <TextView
            android:id="@+id/fourthChallenge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rapid Changes"
            tools:layout_editor_absoluteX="168dp"
            tools:layout_editor_absoluteY="356dp" />

        <TextView
            android:id="@+id/fifthChallenge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tool Support"
            tools:layout_editor_absoluteX="168dp"
            tools:layout_editor_absoluteY="399dp" />

        <TextView
            android:id="@+id/sixthChallenge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Low Tolerance by Users" />

        <TextView
            android:id="@+id/seventhChallenge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Low Awareness of Security and Privacy" />
    </LinearLayout>

    <Button
        android:id="@+id/mainButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="120dp"
        android:text="@string/Back_to_main_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>